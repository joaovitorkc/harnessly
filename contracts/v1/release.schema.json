{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessly.dev/contracts/v1/release.schema.json",
  "title": "Harnessly release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "contract",
    "sourceRevision",
    "publishable",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "harnessly.dev/release/v1"
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "contract": {
      "const": "v1"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(?:WORKTREE|[a-f0-9]{40})$"
    },
    "publishable": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!\\.\\.?$)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publishable": { "const": true }
        }
      },
      "then": {
        "properties": {
          "sourceRevision": {
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    }
  ]
}
