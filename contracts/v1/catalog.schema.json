{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessly.dev/contracts/v1/catalog.schema.json",
  "title": "Harnessly catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "contract", "workflows"],
  "properties": {
    "schemaVersion": {
      "const": "harnessly.dev/catalog/v1"
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "contract": {
      "const": "v1"
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "version", "status", "category", "manifest"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HLY-[0-9]{3}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
          },
          "status": {
            "enum": ["draft", "beta", "stable", "deprecated", "retired"]
          },
          "category": {
            "enum": ["setup", "discovery", "documentation", "harness", "quality", "security"]
          },
          "manifest": {
            "type": "string",
            "pattern": "^prompts/[a-z0-9-]+/manifest\\.yaml$"
          }
        }
      }
    }
  }
}
