{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessly.dev/contracts/v1/projects.schema.json",
  "title": "Harnessly Advanced project registry",
  "$comment": "Project IDs and resolved paths must both be unique; real paths and Git roots require runtime validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspace",
    "topology",
    "authorizedRoot",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "harnessly.dev/projects/v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "topology": {
      "enum": ["EMBEDDED", "PARENT_HUB"]
    },
    "authorizedRoot": {
      "const": ".."
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "gitRoot"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^\\.\\.(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
          },
          "gitRoot": {
            "const": true
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "topology": { "const": "EMBEDDED" }
        }
      },
      "then": {
        "properties": {
          "projects": {
            "maxItems": 1,
            "items": {
              "properties": {
                "path": { "const": ".." }
              }
            }
          }
        }
      }
    }
  ]
}
