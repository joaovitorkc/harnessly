{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessly.dev/contracts/v1/projects.schema.json",
  "title": "Harnessly Advanced project registry",
  "$comment": "Project IDs and resolved paths must both be unique; real paths and Git roots require runtime validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspace",
    "topology",
    "authorizedRoot",
    "routingDoc",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "harnessly.dev/projects/v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "topology": {
      "enum": ["EMBEDDED", "PARENT_HUB"]
    },
    "authorizedRoot": {
      "const": ".."
    },
    "routingDoc": {
      "const": "docs/routing/projects.md"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "path",
          "gitRoot",
          "signals",
          "entrypoint",
          "harness"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          },
          "path": {
            "type": "string",
            "pattern": "^\\.\\.(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
          },
          "gitRoot": {
            "const": true
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          "exclusions": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          "entrypoint": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "harness": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "sensor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "topology": { "const": "EMBEDDED" }
        }
      },
      "then": {
        "properties": {
          "projects": {
            "maxItems": 1,
            "items": {
              "properties": {
                "path": { "const": ".." }
              }
            }
          }
        }
      }
    }
  ]
}
