{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessly.dev/contracts/v1/profile.schema.json",
  "title": "Harnessly setup profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "description",
    "topologies",
    "controlPlane",
    "invariants",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "harnessly.dev/profile/v1"
    },
    "name": {
      "enum": ["STANDARD", "ADVANCED"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "topologies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["REPO_ROOT", "EMBEDDED", "PARENT_HUB"]
      }
    },
    "controlPlane": {
      "type": "string",
      "pattern": "^(?:\\.|orchestrator)$"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "when", "ownership"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!\\.\\.?$)(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*\\\\)(?!.*[<>:\\s])[A-Za-z0-9._*?{},@/+-]+$"
          },
          "when": { "type": "string" },
          "ownership": {
            "enum": ["create-only", "managed-block", "owned-file", "structural-merge"]
          },
          "existingOwnership": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["managed-block", "owned-file", "structural-merge"]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "name": { "const": "STANDARD" }
        }
      },
      "then": {
        "properties": {
          "topologies": { "const": ["REPO_ROOT"] },
          "controlPlane": { "const": "." }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": { "const": "ADVANCED" }
        }
      },
      "then": {
        "properties": {
          "topologies": {
            "allOf": [
              { "contains": { "const": "EMBEDDED" } },
              { "contains": { "const": "PARENT_HUB" } }
            ]
          },
          "controlPlane": { "const": "orchestrator" }
        }
      }
    }
  ]
}
